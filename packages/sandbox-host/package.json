{
  "name": "@clientvm/sandbox-host",
  "version": "0.3.0",
  "description": "The static sandbox ClientVM instances run on: deploy dist/ to a wildcard subdomain of its own domain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reflex-Gravity/client-vm.git",
    "directory": "packages/sandbox-host"
  },
  "homepage": "https://clientvm.joeldsouza.me/docs/hosting/",
  "bugs": "https://github.com/Reflex-Gravity/client-vm/issues",
  "type": "module",
  "bin": {
    "clientvm-check-sandbox": "./bin/check-headers.mjs"
  },
  "files": [
    "dist/__clientvm",
    "!dist/__clientvm/assets/host-*",
    "bin",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@clientvm/agent-api": "workspace:*",
    "@clientvm/clientvm": "workspace:*",
    "@clientvm/kernel": "workspace:*",
    "@clientvm/node-compat": "workspace:*",
    "@clientvm/process": "workspace:*",
    "@clientvm/protocol": "workspace:*",
    "@clientvm/shell": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
