---
// SPDX-License-Identifier: Apache-2.0
// A docs page: the site's nav, a sidebar of every published doc, the page and
// its headings. Used by src/pages/docs/.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { docSections } from '../lib/doc-index.ts';

interface Props {
  title: string;
  description: string;
  /** The current doc's slug, or undefined on the index. */
  slug?: string;
  headings?: { depth: number; slug: string; text: string }[];
  source?: string;
  markdown?: string;
}
const { title, description, slug, headings = [], source, markdown } = Astro.props;
const sections = await docSections();
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${title} · ClientVM docs`} description={description}>
  {markdown && <link slot="head" rel="alternate" type="text/markdown" href={markdown} />}
  <Nav />
  <main class="docs">
    <div class="wrap layout">
      <nav class="side" aria-label="Docs">
        <a class:list={['home', { current: slug === undefined }]} href="/docs/">All docs</a>
        {
          sections.map((s) => (
            <div class="group">
              <p class="label">{s.label}</p>
              <ul>
                {s.docs.map((d) => (
                  <li>
                    <a
                      href={`/docs/${d.slug}/`}
                      class:list={{ current: d.slug === slug }}
                      aria-current={d.slug === slug ? 'page' : undefined}
                    >
                      {d.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <article class="prose">
        <slot />
        {
          source && (
            <p class="source">
              <a href={source}>Edit this page on GitHub ↗</a>
              {markdown && <a href={markdown}>Markdown</a>}
            </p>
          )
        }
      </article>

      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </main>
  <Footer />
</Base>

<style>
  .docs {
    border-bottom: 1px solid var(--line);
  }
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 200px;
    gap: 48px;
    align-items: start;
    padding-block: 48px 80px;
  }
  .side,
  .toc {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    font-size: 14px;
  }
  .label {
    margin: 22px 0 8px;
    color: var(--dim);
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .side ul,
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .side a,
  .toc a {
    display: block;
    padding: 4px 10px;
    border-left: 1px solid var(--line);
    color: var(--muted);
    line-height: 1.45;
    text-decoration: none;
  }
  .side a:hover,
  .toc a:hover {
    color: var(--text);
  }
  .side a.current {
    border-left-color: var(--accent);
    color: var(--text);
    background: var(--accent-soft);
  }
  .home {
    font: 13px var(--mono);
  }
  .toc a {
    font-size: 13px;
  }

  .prose {
    min-width: 0;
    max-width: 760px;
    color: #d5d4d1;
    font-size: 15.5px;
    line-height: 1.7;
  }
  .prose :global(h1) {
    margin: 0 0 20px;
    font: 500 clamp(28px, 4vw, 40px) / 1.15 var(--display);
  }
  .prose :global(h2) {
    margin: 44px 0 12px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font: 600 22px/1.3 var(--sans);
    scroll-margin-top: 80px;
  }
  .prose :global(h3) {
    margin: 30px 0 8px;
    font: 600 17px/1.4 var(--sans);
    scroll-margin-top: 80px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
    font: 0.88em var(--mono);
  }
  .prose :global(pre) {
    padding: 16px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--term-bg) !important;
    font: 13px/1.65 var(--mono);
    overflow-x: auto;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 18px 0;
    border-collapse: collapse;
    font-size: 14px;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--surface);
    color: var(--text);
  }
  .prose :global(blockquote) {
    margin: 18px 0;
    padding: 4px 16px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(li + li) {
    margin-top: 4px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
  }
  .source {
    display: flex;
    gap: 20px;
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font: 13px var(--mono);
  }
  .source a {
    color: var(--muted);
    text-decoration: none;
  }
  .source a:hover {
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .layout {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }
    .side {
      position: static;
      max-height: none;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
