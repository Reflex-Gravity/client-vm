---
// SPDX-License-Identifier: Apache-2.0
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Quickstart from '../components/Quickstart.astro';
import Limits from '../components/Limits.astro';
import OpenSource from '../components/OpenSource.astro';
import Announce from '../components/Announce.astro';
import Footer from '../components/Footer.astro';
import Facts from '../components/Facts.astro';
import DemosBand from '../components/DemosBand.astro';
import XtermImportMap from '../components/XtermImportMap.astro';
import { hero } from '../content/landing.ts';
import { homeGraph } from '../lib/seo.ts';
---

<Base
  title="ClientVM: free, open-source Node.js, bash and npm in a browser tab"
  description={hero.lede}
  jsonLd={homeGraph()}
>
  <XtermImportMap slot="head" />
  <Announce />
  <Nav />
  <main>
    <Hero />
    <Facts />
    <Demo more={{ label: 'More demos', href: '/demos/' }} />
    <HowItWorks />
    <Features />
    <DemosBand />
    <Quickstart />
    <Limits />
    <OpenSource />
  </main>
  <Footer />
</Base>
