---
// SPDX-License-Identifier: Apache-2.0
import { nav, REPO } from '../content/landing.ts';
---

<header class="nav">
  <div class="wrap inner">
    <a class="brand" href="/" aria-label="ClientVM home">
      <img src="/favicon.svg" alt="" width="22" height="22" />
      <span>clientvm</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="gh" href={REPO}>GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #060608d9;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 20px var(--display);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font: 13px var(--mono);
    text-transform: lowercase;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  nav a:hover {
    color: var(--text);
  }
  .gh {
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color 0.15s;
  }
  .gh:hover {
    border-color: var(--accent);
  }
  @media (max-width: 720px) {
    nav a:not(.gh) {
      display: none;
    }
  }
</style>
