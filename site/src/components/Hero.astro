---
// SPDX-License-Identifier: Apache-2.0
import GridPattern from './GridPattern.astro';
import Demo from './Demo.astro';
import { agentPrompt, hero } from '../content/landing.ts';

// The headline blurs in word by word (after Motion Primitives' TextEffect);
// pure CSS, so it needs no JavaScript.
const words = hero.title.split(' ');

---

<section class="hero">
  <GridPattern />
  <div class="wrap inner">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="blur-in" aria-label={hero.title}>
        {
          words.map((w, i) => (
            <span aria-hidden="true" style={`--i: ${i}`}>
              {w}{' '}
            </span>
          ))
        }
      </h1>
      <p class="lede">{hero.lede}</p>
      <div class="install" role="group" aria-label="Install command">
        <code><span aria-hidden="true">$ </span>{hero.install}</code>
        <button type="button" class="copy-btn" data-copy={hero.install} aria-label="Copy install command">
          copy
        </button>
      </div>
      <div class="ctas">
        <a class="btn primary" href="#demo">Try it in this tab</a>
        <button type="button" class="btn" data-copy={agentPrompt} data-copied-label="Prompt copied">
          Copy agent prompt
        </button>
      </div>
    </div>
    <Demo />
  </div>
</section>

<script>
  import '../scripts/copy.ts';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    border-top: 0;
    padding-block: 88px 96px;
    background:
      radial-gradient(60% 50% at 80% 0%, #7be3b414, transparent 70%),
      radial-gradient(40% 40% at 0% 100%, #6aa7ff0d, transparent 70%);
  }
  /* Wider than the page's other sections, so the live demo has room. */
  .inner {
    display: grid;
    width: min(1480px, 100% - 48px);
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: 48px;
    align-items: center;
  }
  h1 {
    font-size: clamp(36px, 4.2vw, 56px);
    max-width: 14ch;
  }
  .blur-in span {
    display: inline-block;
    white-space: pre;
    animation: blur-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 70ms + 80ms);
  }
  @keyframes blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blur-in span {
      animation: none;
    }
  }
  .lede {
    max-width: 52ch;
    margin: 24px 0 32px;
    color: var(--muted);
    font-size: 17px;
  }
  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 560px;
    padding: 10px 10px 10px 16px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    font-size: 14px;
  }
  .install code {
    overflow-x: auto;
    white-space: nowrap;
  }
  .install code span {
    color: var(--muted);
  }
  .copy-btn {
    flex: none;
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .copy-btn:hover {
    color: var(--text);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  @media (max-width: 1180px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
