---
// SPDX-License-Identifier: Apache-2.0
import GridPattern from './GridPattern.astro';
import TerminalWindow from './TerminalWindow.astro';
import { agentPrompt, hero } from '../content/landing.ts';

// An illustrative session. Without JavaScript, or with reduced motion, it is
// shown as is; otherwise src/scripts/transcript.ts types it out.
const transcript: { kind: 'cmd' | 'out' | 'dim' | 'ok'; text: string }[] = [
  { kind: 'cmd', text: 'node -p process.version' },
  { kind: 'out', text: 'v24.11.0' },
  { kind: 'cmd', text: 'npm create vite@latest app -- --template react-ts' },
  { kind: 'dim', text: 'Scaffolding project in /home/user/app...' },
  { kind: 'cmd', text: 'cd app && npm install' },
  { kind: 'out', text: 'added 187 packages, and audited 188 packages' },
  { kind: 'cmd', text: 'npm run dev' },
  { kind: 'ok', text: '  VITE v8  ready' },
  { kind: 'out', text: '  ➜  Local:   https://k3x9…-p5173.sandbox/' },
];

// Built as one string: whitespace in a <pre> is significant, so the template's
// own indentation must not reach it.
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// The headline blurs in word by word (after Motion Primitives' TextEffect);
// pure CSS, so it needs no JavaScript.
const words = hero.title.split(' ');

const transcriptHtml =
  transcript
    .map(
      (l) =>
        `<span class="line ${l.kind}">${l.kind === 'cmd' ? '<span class="ps">$ </span>' : ''}` +
        `<span class="t">${escape(l.text)}</span>\n</span>`,
    )
    .join('') + '<span class="cursor" aria-hidden="true"></span>';
---

<section class="hero">
  <GridPattern />
  <div class="wrap inner">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="blur-in" aria-label={hero.title}>
        {
          words.map((w, i) => (
            <span aria-hidden="true" style={`--i: ${i}`}>
              {w}{' '}
            </span>
          ))
        }
      </h1>
      <p class="lede">{hero.lede}</p>
      <div class="install" role="group" aria-label="Install command">
        <code><span aria-hidden="true">$ </span>{hero.install}</code>
        <button type="button" class="copy-btn" data-copy={hero.install} aria-label="Copy install command">
          copy
        </button>
      </div>
      <div class="ctas">
        <a class="btn primary" href="#demo">Try it in this tab</a>
        <button type="button" class="btn" data-copy={agentPrompt} data-copied-label="Prompt copied">
          Copy agent prompt
        </button>
      </div>
    </div>
    <TerminalWindow title="user@clientvm: ~" class="hero-term">
      <pre class="transcript" data-transcript set:html={transcriptHtml} />
    </TerminalWindow>
  </div>
</section>

<script>
  import '../scripts/copy.ts';
  import '../scripts/transcript.ts';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    border-top: 0;
    padding-block: 88px 96px;
    background:
      radial-gradient(60% 50% at 80% 0%, #7be3b414, transparent 70%),
      radial-gradient(40% 40% at 0% 100%, #6aa7ff0d, transparent 70%);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: center;
  }
  h1 {
    font-size: clamp(40px, 6vw, 64px);
    max-width: 14ch;
  }
  .blur-in span {
    display: inline-block;
    white-space: pre;
    animation: blur-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 70ms + 80ms);
  }
  @keyframes blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blur-in span {
      animation: none;
    }
  }
  .lede {
    max-width: 52ch;
    margin: 24px 0 32px;
    color: var(--muted);
    font-size: 18px;
  }
  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 560px;
    padding: 10px 10px 10px 16px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    font-size: 14px;
  }
  .install code {
    overflow-x: auto;
    white-space: nowrap;
  }
  .install code span {
    color: var(--muted);
  }
  .copy-btn {
    flex: none;
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .copy-btn:hover {
    color: var(--text);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  .transcript {
    margin: 0;
    padding: 20px;
    min-height: 300px;
    font-size: 13.5px;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .transcript :global(.ps) {
    color: var(--accent);
  }
  .transcript :global(.out) {
    color: #c7ccd3;
  }
  .transcript :global(.dim) {
    color: var(--muted);
  }
  .transcript :global(.ok) {
    color: var(--accent);
  }
  .transcript :global(.cursor) {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .transcript :global(.cursor) {
      animation: none;
    }
  }
  @media (max-width: 920px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
