---
// SPDX-License-Identifier: Apache-2.0
import GridPattern from './GridPattern.astro';
import TerminalWindow from './TerminalWindow.astro';
import { REPO, agentPrompt, hero, openSource, version } from '../content/landing.ts';

type Line = { kind: 'cmd' | 'out' | 'dim' | 'ok'; text: string };

// Illustrative sessions, one per tab. Without JavaScript, or with reduced
// motion, they are shown as is; otherwise src/scripts/transcript.ts types out
// the selected one and moves on to the next.
const sessions: { id: string; label: string; lines: Line[] }[] = [
  {
    id: 'vite',
    label: 'vite + react',
    lines: [
      { kind: 'cmd', text: 'npm create vite@latest app -- --template react-ts' },
      { kind: 'dim', text: 'Scaffolding project in /home/user/app...' },
      { kind: 'cmd', text: 'cd app && npm install' },
      { kind: 'out', text: 'added 187 packages, and audited 188 packages in 9s' },
      { kind: 'cmd', text: 'npm run dev' },
      { kind: 'ok', text: '  VITE v8  ready in 412 ms' },
      { kind: 'out', text: '  ➜  Local:   https://k3x9…-p5173.sandbox/' },
    ],
  },
  {
    id: 'express',
    label: 'express',
    lines: [
      { kind: 'cmd', text: 'npm install express' },
      { kind: 'out', text: 'added 66 packages in 4s' },
      { kind: 'cmd', text: 'node server.js &' },
      { kind: 'dim', text: '[1] 7' },
      { kind: 'ok', text: 'listening on http://localhost:3000' },
      { kind: 'cmd', text: 'curl -s localhost:3000/api/hello' },
      { kind: 'out', text: '{"hello":"from a browser tab","node":"v24.11.0"}' },
    ],
  },
  {
    id: 'bash',
    label: 'bash',
    lines: [
      { kind: 'cmd', text: 'uname -sr && node -v' },
      { kind: 'out', text: 'Linux 6.1.0-clientvm\nv24.11.0' },
      { kind: 'cmd', text: "cut -d, -f2 sales.csv | sort | uniq -c | sort -rn | head -3" },
      { kind: 'out', text: '     41 north\n     28 west\n     17 east' },
      { kind: 'cmd', text: 'git init -q && git add . && git commit -qm init && git log --oneline' },
      { kind: 'ok', text: 'a1c9e02 init' },
    ],
  },
];

// Built as one string: whitespace in a <pre> is significant, so the template's
// own indentation must not reach it.
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const render = (lines: Line[]) =>
  lines
    .map(
      (l) =>
        `<span class="line ${l.kind}">${l.kind === 'cmd' ? '<span class="ps">~/app $ </span>' : ''}` +
        `<span class="t">${escape(l.text)}</span>\n</span>`,
    )
    .join('') + '<span class="cursor" aria-hidden="true"></span>';

// The headline blurs in word by word (after Motion Primitives' TextEffect);
// pure CSS, so it needs no JavaScript.
const words = hero.title.split(' ');
---

<section class="hero">
  <GridPattern />
  <div class="wrap inner">
    <div class="copy">
      <div class="badges">
        <a class="badge oss" href={REPO}>
          <span class="dot" aria-hidden="true"></span>
          {openSource.badge}
        </a>
        <a class="badge" href={`${REPO}/blob/main/LICENSE`}>{openSource.license}</a>
        <a class="badge beta" href="#limits" title="Pre-1.0: see what it doesn't do yet">
          beta · v{version}
        </a>
        <span class="badge plain">{hero.eyebrow}</span>
      </div>
      <h1 class="blur-in" aria-label={hero.title}>
        {
          words.map((w, i) => (
            <span aria-hidden="true" style={`--i: ${i}`}>
              {w}{' '}
            </span>
          ))
        }
      </h1>
      <p class="lede">{hero.lede}</p>
      <div class="install" role="group" aria-label="Install command">
        <code><span aria-hidden="true">$ </span>{hero.install}</code>
        <button type="button" class="copy-btn" data-copy={hero.install} aria-label="Copy install command">
          copy
        </button>
      </div>
      <div class="ctas">
        <a class="btn primary" href="#demo">Try it in this tab →</a>
        <button type="button" class="btn" data-copy={agentPrompt} data-copied-label="Prompt copied">
          Copy agent prompt
        </button>
      </div>
    </div>

    <TerminalWindow title="user@clientvm" class="hero-term">
      <div class="tabs" slot="actions" role="tablist" aria-label="Example sessions" data-tabs data-transcript-tabs>
        {
          sessions.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`hero-tab-${s.id}`}
              aria-controls={`hero-panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {s.label}
            </button>
          ))
        }
      </div>
      {
        sessions.map((s, i) => (
          <pre
            class="transcript"
            role="tabpanel"
            id={`hero-panel-${s.id}`}
            aria-labelledby={`hero-tab-${s.id}`}
            hidden={i !== 0}
            data-transcript
            set:html={render(s.lines)}
          />
        ))
      }
      <div class="meter" aria-hidden="true"><i data-transcript-meter></i></div>
    </TerminalWindow>
  </div>
</section>

<script>
  import '../scripts/copy.ts';
  import '../scripts/tabs.ts';
  import '../scripts/transcript.ts';
</script>

<style>
  .hero {
    padding-block: 104px 112px;
    overflow: hidden;
    background:
      radial-gradient(50% 60% at 85% 10%, #7be3b412, transparent 70%),
      radial-gradient(40% 40% at 0% 100%, #6aa7ff0a, transparent 70%);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: center;
  }
  h1 {
    max-width: 15ch;
    font-size: clamp(40px, 5.6vw, 70px);
    line-height: 0.98;
  }
  /* Free and open source, said first. */
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.04em;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  a.badge:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .badge.oss {
    border-color: #7be3b466;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge.beta {
    border-color: #f2c47a55;
    color: var(--warn);
  }
  a.badge.beta:hover {
    border-color: var(--warn);
    color: var(--warn);
  }
  .badge.plain {
    border-color: transparent;
    padding-inline: 4px;
    color: var(--dim);
  }
  .dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .blur-in span {
    display: inline-block;
    white-space: pre;
    animation: blur-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 70ms + 80ms);
  }
  @keyframes blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blur-in span {
      animation: none;
    }
  }
  .lede {
    max-width: 50ch;
    margin: 28px 0 32px;
    color: var(--muted);
    font-size: 17px;
  }
  .install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 560px;
    padding: 10px 10px 10px 16px;
    background: var(--term-bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 14px;
  }
  .install code {
    overflow-x: auto;
    white-space: nowrap;
  }
  .install code span {
    color: var(--accent);
  }
  .copy-btn {
    flex: none;
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #ffffff06;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  /* ---- command window ---- */
  .tabs {
    display: flex;
    gap: 2px;
  }
  [role='tab'] {
    padding: 3px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  [role='tab']:hover {
    color: var(--text);
  }
  [role='tab'][aria-selected='true'] {
    border-color: var(--line-strong);
    background: #ffffff0a;
    color: var(--text);
  }
  .transcript {
    margin: 0;
    padding: 22px 22px 26px;
    min-height: 320px;
    font-size: 13.5px;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .transcript[hidden] {
    display: none;
  }
  .transcript :global(.ps) {
    color: var(--accent);
  }
  .transcript :global(.out) {
    color: #c7c6cc;
  }
  .transcript :global(.dim) {
    color: var(--muted);
  }
  .transcript :global(.ok) {
    color: var(--accent);
  }
  .transcript :global(.cursor) {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  /* How long until the next session plays. */
  .meter {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }
  .meter i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .transcript :global(.cursor) {
      animation: none;
    }
    .meter {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .hero-term :global(.dots) {
      display: none;
    }
  }
</style>
