---
// SPDX-License-Identifier: Apache-2.0
// A faint grid behind the hero where a few cells light up and fade, like
// Magic UI's Animated Grid Pattern, in plain SVG. scripts/grid.ts moves the
// cells; without JavaScript or with reduced motion the grid stays still.
const SIZE = 44;
---

<div class="grid-pattern" aria-hidden="true">
  <svg data-grid data-size={SIZE}>
    <defs>
      <pattern id="hero-grid" width={SIZE} height={SIZE} patternUnits="userSpaceOnUse" x="-1" y="-1">
        <path d={`M.5 ${SIZE}V.5H${SIZE}`} fill="none" stroke="currentColor"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
    <g data-grid-cells></g>
  </svg>
</div>

<script>
  import '../scripts/grid.ts';
</script>

<style>
  .grid-pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    color: #ffffff0f;
    mask-image: radial-gradient(70% 65% at 60% 35%, #000 20%, transparent 80%);
  }
  svg {
    width: 100%;
    height: 100%;
  }
  svg :global(rect.cell) {
    fill: #7be3b4;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }
  svg :global(rect.cell.on) {
    opacity: 0.09;
  }
</style>
