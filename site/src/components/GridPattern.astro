---
// SPDX-License-Identifier: Apache-2.0
// A dot matrix behind the hero where a few dots light up and fade, after
// microsandbox.dev's dot-matrix texture, in plain SVG. scripts/grid.ts lights
// the cells; without JavaScript or with reduced motion the matrix stays still.
const SIZE = 22;
---

<div class="grid-pattern" aria-hidden="true">
  <svg data-grid data-size={SIZE}>
    <defs>
      <pattern id="hero-grid" width={SIZE} height={SIZE} patternUnits="userSpaceOnUse">
        <rect x={SIZE / 2 - 1} y={SIZE / 2 - 1} width="2" height="2" fill="currentColor"></rect>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
    <g data-grid-cells></g>
  </svg>
</div>

<script>
  import '../scripts/grid.ts';
</script>

<style>
  .grid-pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    color: #ffffff1c;
    mask-image: radial-gradient(75% 70% at 70% 40%, #000 15%, transparent 85%);
  }
  svg {
    width: 100%;
    height: 100%;
  }
  svg :global(rect.cell) {
    fill: #7be3b4;
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
  }
  svg :global(rect.cell.on) {
    opacity: 0.85;
  }
</style>
