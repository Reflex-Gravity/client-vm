---
// SPDX-License-Identifier: Apache-2.0
// The window chrome shared by the hero transcript, the live demo and the quickstart.
interface Props {
  title?: string;
  class?: string;
}
const { title = '', class: className = '' } = Astro.props;
---

<div class:list={['window', className]}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
    <span class="actions"><slot name="actions" /></span>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--term-bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -30px #000000d0;
    overflow: hidden;
  }
  .bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    height: 36px;
    padding: 0 12px;
    background: #09090c;
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  /* Square window controls, in keeping with the page's pixel look. */
  .dots i {
    width: 7px;
    height: 7px;
    background: #ffffff26;
  }
  .title {
    overflow: hidden;
    color: var(--muted);
    font: 12px var(--mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }
  .body {
    position: relative;
    flex: 1;
    min-height: 0;
  }
</style>
