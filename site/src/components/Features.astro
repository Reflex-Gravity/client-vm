---
// SPDX-License-Identifier: Apache-2.0
import { features } from '../content/landing.ts';
---

<section id="features">
  <div class="wrap">
    <p class="eyebrow"><span><span class="n">03</span> / what runs</span></p>
    <h2>The tools a coding agent reaches for, unmodified.</h2>
    <p class="section-lede">
      ClientVM runs the real npm, pnpm, Vite and git rather than look-alikes, and measures itself
      against Node, bash and git in CI.
    </p>
    <div class="grid features" data-spotlight-group>
      {
        features.map((f) => (
          <a class="card feature" href={f.href} data-spotlight>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="more" aria-hidden="true">
              docs →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/spotlight.ts';
</script>

<style>
  .features {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: background 0.2s;
  }
  /* The pointer's light (scripts/spotlight.ts sets --x/--y), after Magic UI's Magic Card. */
  .feature::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    background: radial-gradient(
      260px circle at var(--x, 50%) var(--y, 50%),
      #7be3b41a,
      transparent 70%
    );
  }
  .feature:hover {
    background: var(--surface);
  }
  .feature:hover::before {
    opacity: 1;
  }
  .feature > * {
    position: relative;
  }
  .more {
    margin-top: auto;
    padding-top: 20px;
    font: 12px var(--mono);
    color: var(--muted);
  }
  .feature:hover .more {
    color: var(--accent);
  }
  @media (max-width: 1000px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
