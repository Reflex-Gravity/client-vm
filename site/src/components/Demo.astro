---
// SPDX-License-Identifier: Apache-2.0
// The live demo, shown in the hero (components/Hero.astro): an editor, a
// terminal and a preview of one ClientVM instance. Nothing of ClientVM loads
// until a visitor presses start (src/demo/entry.ts imports src/demo/run.ts on
// click). The setup is typed
// into the terminal's bash, so its output shows there. The editor is
// src/demo/editor.ts.
import TerminalWindow from './TerminalWindow.astro';
---

<div id="demo" class="demo">
    <div class="stage" data-demo>
      <TerminalWindow title="editor" class="editor-window">
        <span slot="actions" class="hint" data-editor-state aria-live="polite"></span>
        <div class="editor" data-editor>
          <div class="file-tabs" role="tablist" aria-label="Files" data-editor-tabs></div>
          <div class="code" data-editor-code hidden>
            <pre class="gutter" aria-hidden="true" data-editor-gutter></pre>
            <div class="area">
              <pre class="hl" aria-hidden="true" data-editor-hl></pre>
              <textarea
                data-editor-input
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                wrap="off"
                aria-describedby="demo-editor-help"></textarea>
            </div>
          </div>
          <p class="placeholder" data-editor-empty>The project's files open here.</p>
          <p class="visually-hidden" id="demo-editor-help">
            Changes save as you type. Press Escape, then Tab, to leave the editor.
          </p>
        </div>
      </TerminalWindow>

      <TerminalWindow title="terminal" class="term-window">
        <button slot="actions" type="button" class="mini" data-demo-reset hidden>reset</button>
        <div class="term" data-demo-term></div>
      </TerminalWindow>

      <TerminalWindow title="preview" class="preview-window">
        <span slot="actions" class="status" data-demo-port></span>
        <iframe data-demo-preview title="Preview of the server running in the demo"></iframe>
        <p class="empty" data-demo-empty>
          <span class="wait" aria-hidden="true"></span>
          The page the server serves shows here once it is listening.
        </p>
      </TerminalWindow>

      <div class="overlay" data-demo-overlay>
        <div class="choices" data-demo-choices>
          <button type="button" class="btn primary" data-demo-start="express">
            Start an Express app
          </button>
          <button type="button" class="btn" data-demo-start="vite">
            Start a Vite + React project
          </button>
        </div>
        <p class="note" data-demo-note>
          Each one runs npm install and starts the server in the terminal, where you see its
          output. The Vite project builds once, about 10 seconds, and is cached in this browser
          after that.
        </p>
      </div>
    </div>
    <p class="statusline" aria-live="polite"><span data-demo-status>idle</span></p>
</div>

<script>
  import '../demo/entry.ts';
</script>

<style>
  .demo {
    scroll-margin-top: 88px;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-areas:
      'editor preview'
      'term term';
    gap: 12px;
    height: 640px;
  }
  .stage :global(.window) {
    position: relative;
    height: 100%;
  }
  .stage :global(.editor-window) {
    grid-area: editor;
  }
  .stage :global(.term-window) {
    grid-area: term;
  }
  .stage :global(.preview-window) {
    grid-area: preview;
  }
  [hidden] {
    display: none !important;
  }

  /* ---- start overlay, over all three windows ---- */
  .overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 32px;
    text-align: center;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(0deg, #ffffff05 0 1px, transparent 1px 4px),
      #07090bcc;
    backdrop-filter: blur(3px);
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .note {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .note.error {
    color: var(--err);
  }

  /* ---- editor ---- */
  .editor {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #07090b;
  }
  .file-tabs {
    display: flex;
    flex: none;
    overflow-x: auto;
    background: var(--surface);
    scrollbar-width: none;
  }
  .file-tabs:empty {
    display: none;
  }
  .file-tabs :global(.file-tab) {
    padding: 6px 14px;
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    white-space: nowrap;
    cursor: pointer;
  }
  .file-tabs :global(.file-tab:hover) {
    color: var(--text);
  }
  .file-tabs :global(.file-tab[aria-selected='true']) {
    background: #07090b;
    border-bottom-color: var(--accent);
    color: var(--text);
  }
  .code {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    font: 13px/1.55 var(--mono);
  }
  .gutter {
    flex: none;
    min-width: 4ch;
    margin: 0;
    padding: 10px 10px 10px 12px;
    border-right: 1px solid var(--line);
    color: #4a515b;
    font: inherit;
    text-align: right;
    user-select: none;
  }
  .area {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .hl,
  textarea {
    margin: 0;
    padding: 10px 14px;
    font: inherit;
    white-space: pre;
    tab-size: 2;
  }
  .hl {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 100%;
    color: #c9d1d9;
    pointer-events: none;
  }
  textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    outline: none;
    resize: none;
    overflow: auto;
    background: transparent;
    color: transparent;
    caret-color: var(--accent);
    scrollbar-width: thin;
  }
  textarea::selection {
    background: #7be3b433;
  }
  .hl :global(.tk-kw) {
    color: #c792ea;
  }
  .hl :global(.tk-str) {
    color: #a8e6a1;
  }
  .hl :global(.tk-num),
  .hl :global(.tk-lit) {
    color: #f2c47a;
  }
  .hl :global(.tk-com) {
    color: #5c6470;
    font-style: italic;
  }
  .hl :global(.tk-tag) {
    color: #82aaff;
  }
  .hl :global(.tk-key) {
    color: #89ddff;
  }
  .placeholder {
    display: grid;
    flex: 1;
    place-content: center;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .hint {
    overflow: hidden;
    color: var(--muted);
    font: 12px var(--mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ---- terminal ---- */
  .term {
    position: absolute;
    inset: 0;
    padding: 10px 0 10px 12px;
    background: #07090b;
  }
  .mini {
    padding: 2px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .mini:hover {
    color: var(--text);
  }

  /* ---- preview ---- */
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  iframe:not([src]) {
    display: none;
  }
  .empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    margin: 0;
    padding: 32px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }
  .wait {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid #ffffff1f;
    border-top-color: var(--muted);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  .stage[data-busy] .wait {
    display: block;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .status {
    font: 12px var(--mono);
    color: var(--accent);
  }
  .statusline {
    margin: 12px 0 0;
    font: 12px var(--mono);
    color: var(--muted);
  }
  code {
    font-size: 0.92em;
    color: var(--text);
  }

  /* A light that runs around the windows while the demo sets up, after Magic UI's Border Beam. */
  @property --beam-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .stage[data-busy] :global(.window)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: conic-gradient(
      from var(--beam-angle),
      transparent 0 72%,
      #7be3b400 74%,
      #7be3b4 86%,
      #a6f0ff 88%,
      transparent 90%
    );
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    animation: beam 3.2s linear infinite;
  }
  .stage[data-busy] :global(.term-window)::after {
    animation-delay: -1.1s;
  }
  .stage[data-busy] :global(.preview-window)::after {
    animation-delay: -2.2s;
  }
  @keyframes beam {
    to {
      --beam-angle: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage[data-busy] :global(.window)::after {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 320px 380px 280px;
      grid-template-areas: 'editor' 'preview' 'term';
      height: auto;
    }
  }
</style>
