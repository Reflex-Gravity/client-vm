---
// SPDX-License-Identifier: Apache-2.0
// The live demo: pick an example, start it, and a terminal, an editor and a
// preview of one ClientVM instance come alive. Nothing of ClientVM loads until
// a visitor presses start (src/demo/entry.ts imports src/demo/run.ts on
// click). The setup is typed into the terminal's bash, so its output shows
// there; the "try" chips type more commands the same way. The demos are
// src/demos/catalog.ts; the editor is src/demo/editor.ts.
import TerminalWindow from './TerminalWindow.astro';
import { DEMOS, type Demo } from '../demos/catalog.ts';
import { REPO, version } from '../content/landing.ts';

interface Props {
  /** The demos to offer, in the picker's order; the first is selected. */
  demos?: Demo[];
}
const { demos = DEMOS.slice(0, 3) } = Astro.props;

const STEP_LABELS = { boot: 'boot', install: 'npm install', start: 'start', ready: 'ready' };
---

<section id="demo" class="demo">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow"><span><span class="n">01</span> / live demo</span></p>
        <h2>Run it. <span class="soft">Right here, in this tab.</span></h2>
      </div>

      <div class="picker" role="group" aria-label="Examples" data-demo-picker>
        {
          demos.map((ex, i) => (
            <button
              type="button"
              class="pick"
              data-demo-pick={ex.slug}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="pick-n">{String.fromCharCode(65 + i)}</span>
              <span class="pick-name">{ex.name}</span>
              <span class="pick-tag">{ex.tag}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="stage" data-demo>
      <TerminalWindow title="bash · ~/app" class="term-window">
        <button slot="actions" type="button" class="mini" data-demo-reset hidden>reset</button>
        <div class="term-body">
          {
            demos.map((ex) => (
              <div class="chips" data-demo-chips={ex.slug} hidden>
                <span class="chips-label" aria-hidden="true">
                  try
                </span>
                {ex.triggers.map((t) => (
                  <button
                    type="button"
                    class="chip"
                    data-demo-try={t.command}
                    title={t.command}
                    disabled
                  >
                    {t.label}
                  </button>
                ))}
              </div>
            ))
          }
          <div class="term-wrap">
            <div class="term" data-demo-term></div>
            <p class="term-hint" data-demo-term-hint hidden>
              This is a real terminal. Click into it and type.
            </p>
          </div>
        </div>
      </TerminalWindow>

      <TerminalWindow title="editor" class="editor-window">
        <span slot="actions" class="hint" data-editor-state aria-live="polite"></span>
        <div class="editor" data-editor>
          <div class="file-tabs" role="tablist" aria-label="Files" data-editor-tabs></div>
          <div class="code" data-editor-code hidden>
            <pre class="gutter" aria-hidden="true" data-editor-gutter></pre>
            <div class="area">
              <pre class="hl" aria-hidden="true" data-editor-hl></pre>
              <textarea
                data-editor-input
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                wrap="off"
                aria-describedby="demo-editor-help"></textarea>
            </div>
          </div>
          <p class="placeholder" data-editor-empty>The project's files open here.</p>
          <p class="visually-hidden" id="demo-editor-help">
            Changes save as you type. Press Escape, then Tab, to leave the editor.
          </p>
        </div>
      </TerminalWindow>

      <TerminalWindow title="preview" class="preview-window">
        <span slot="actions" class="preview-tools">
          <select class="ports" data-demo-ports aria-label="Port to preview" hidden></select>
          <span class="status" data-demo-port></span>
          <button
            type="button"
            class="tool"
            data-demo-reload
            title="Reload the preview"
            aria-label="Reload the preview"
            disabled>↻</button
          >
          <button
            type="button"
            class="tool"
            data-demo-expand
            title="Full-size preview"
            aria-label="Full-size preview"
            aria-pressed="false">⤢</button
          >
        </span>
        <iframe data-demo-preview title="Preview of the server running in the demo"></iframe>
        <p class="empty" data-demo-empty>
          <span class="wait" aria-hidden="true"></span>
          <span data-demo-empty-text>The page the server serves shows here.</span>
        </p>
      </TerminalWindow>

      <div class="overlay" data-demo-overlay>
        <div class="choices" data-demo-choices>
          {
            demos.map((ex, i) => (
              <button
                type="button"
                class="btn primary start"
                data-demo-start={ex.slug}
                hidden={i !== 0}
              >
                <span class="play" aria-hidden="true" />
                {ex.start}
              </button>
            ))
          }
        </div>
        <p class="note-title" data-demo-note-title hidden></p>
        <p class="note" data-demo-note></p>
        <button type="button" class="btn primary start" data-demo-retry hidden>
          <span class="play" aria-hidden="true"></span>
          Retry
        </button>
      </div>
    </div>

    <div class="statusbar" data-demo-bar>
      <span class="scan" aria-hidden="true"></span>
      <ol class="steps" aria-label="Setup" data-demo-steps>
        {
          Object.entries(STEP_LABELS).map(([step, label]) => (
            <li data-step={step}>
              <i aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ol>
      <p class="statusline" aria-live="polite">
        <span data-demo-status>idle</span>
        <button type="button" class="mini retry" data-demo-retry hidden>retry</button>
      </p>
    </div>
    <p class="firstrun" data-demo-firstrun hidden>
      First run in this browser: the project is built once and cached, and npm and the
      WebAssembly build tools are downloaded on first use. Later runs start in seconds.
    </p>
    <p class="beta">
      <span class="beta-tag">beta</span>
      <span>
        ClientVM is pre-1.0 (v{version}): things can break, and APIs may change between
        releases. Found a bug? <a href={`${REPO}/issues`}>Open an issue</a>.
      </span>
    </p>
  </div>
</section>

<script>
  import '../demo/entry.ts';
</script>

<style>
  [hidden] {
    display: none !important;
  }

  /* ---- heading and example picker ---- */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: end;
    margin-bottom: 32px;
  }
  .picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(170px, max-content));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .pick {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    padding: 14px 16px 14px 14px;
    border: 0;
    background: var(--bg);
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .pick::before {
    content: '';
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pick:hover {
    background: var(--surface);
    color: var(--text);
  }
  .pick[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
  }
  .pick[aria-pressed='true']::before {
    transform: scaleX(1);
  }
  .pick-n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--line-strong);
    font: 500 11px var(--mono);
  }
  .pick[aria-pressed='true'] .pick-n {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pick-name {
    font: 500 14px var(--sans);
  }
  .pick-tag {
    overflow: hidden;
    color: var(--muted);
    font: 11px var(--mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ---- stage ---- */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      'term preview'
      'editor preview';
    gap: 12px;
    height: 700px;
  }
  .stage :global(.window) {
    position: relative;
    height: 100%;
    transition:
      opacity 0.4s,
      border-color 0.4s;
  }
  .stage :global(.editor-window) {
    grid-area: editor;
  }
  .stage :global(.term-window) {
    grid-area: term;
  }
  .stage :global(.preview-window) {
    grid-area: preview;
  }

  /* ---- start overlay, over all three windows ---- */
  .overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 32px;
    text-align: center;
    background:
      radial-gradient(circle at center, #7be3b414, transparent 45%),
      repeating-linear-gradient(0deg, #ffffff04 0 1px, transparent 1px 3px),
      #060608c7;
    backdrop-filter: blur(2px);
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .start {
    height: 52px;
    padding: 0 26px;
    font-size: 15px;
    box-shadow:
      0 0 0 6px #7be3b414,
      0 0 40px -6px #7be3b480;
  }
  .play {
    width: 0;
    height: 0;
    border-block: 6px solid transparent;
    border-left: 9px solid currentColor;
  }
  .note {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .note:empty {
    display: none;
  }
  .note.error {
    color: var(--err);
  }

  /* ---- terminal and its "try" chips ---- */
  .term-body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--term-bg);
  }
  .chips {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    background: #09090c;
    scrollbar-width: none;
    /* Fades at the right edge, so the row reads as scrollable. */
    mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
  }
  .chips-label {
    flex: none;
    margin-right: 2px;
    color: var(--dim);
    font: 11px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .chip {
    flex: none;
    padding: 3px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #ffffff05;
    color: var(--text);
    font: 12px var(--mono);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s,
      color 0.15s;
  }
  .chip::before {
    content: '$ ';
    color: var(--accent);
  }
  .chip:hover:not([disabled]) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .chip[disabled] {
    color: var(--dim);
    cursor: default;
  }
  .chip[disabled]::before {
    color: var(--dim);
  }
  .chip.typing {
    border-color: var(--accent);
    color: var(--accent);
  }
  .term-wrap {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .beta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .beta a {
    color: var(--accent);
  }
  .beta-tag {
    padding: 2px 7px;
    border: 1px solid #f2c47a66;
    color: var(--warn);
    font: 500 10.5px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Inset rather than padded: xterm.js's fit addon sizes the terminal to this
     element's whole box, padding included, so padding would push the last
     rows out of view. */
  .term {
    position: absolute;
    inset: 10px 4px 10px 12px;
  }
  .term :global(.xterm-viewport) {
    scrollbar-width: thin;
  }
  .mini {
    padding: 2px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .mini:hover {
    border-color: var(--err);
    color: var(--text);
  }

  /* ---- editor ---- */
  .editor {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--term-bg);
  }
  .file-tabs {
    display: flex;
    flex: none;
    overflow-x: auto;
    background: #09090c;
    scrollbar-width: none;
  }
  .file-tabs:empty {
    display: none;
  }
  .file-tabs :global(.file-tab) {
    padding: 6px 14px;
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    white-space: nowrap;
    cursor: pointer;
  }
  .file-tabs :global(.file-tab:hover) {
    color: var(--text);
  }
  .file-tabs :global(.file-tab[aria-selected='true']) {
    background: var(--term-bg);
    border-bottom-color: var(--accent);
    color: var(--text);
  }
  .code {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    font: 13px/1.55 var(--mono);
  }
  .gutter {
    flex: none;
    min-width: 4ch;
    margin: 0;
    padding: 10px 10px 10px 12px;
    border-right: 1px solid var(--line);
    color: #4a4a52;
    font: inherit;
    text-align: right;
    user-select: none;
  }
  .area {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .hl,
  textarea {
    margin: 0;
    padding: 10px 14px;
    font: inherit;
    white-space: pre;
    tab-size: 2;
  }
  .hl {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 100%;
    color: #c9d1d9;
    pointer-events: none;
  }
  textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    outline: none;
    resize: none;
    overflow: auto;
    background: transparent;
    color: transparent;
    caret-color: var(--accent);
    scrollbar-width: thin;
  }
  textarea::selection {
    background: #7be3b433;
  }
  .hl :global(.tk-kw) {
    color: #c792ea;
  }
  .hl :global(.tk-str) {
    color: #a8e6a1;
  }
  .hl :global(.tk-num),
  .hl :global(.tk-lit) {
    color: #f2c47a;
  }
  .hl :global(.tk-com) {
    color: #5c5c66;
    font-style: italic;
  }
  .hl :global(.tk-tag) {
    color: #82aaff;
  }
  .hl :global(.tk-key) {
    color: #89ddff;
  }
  .placeholder {
    display: grid;
    flex: 1;
    place-content: center;
    margin: 0;
    color: var(--dim);
    font: 13px var(--mono);
  }
  .hint {
    overflow: hidden;
    color: var(--muted);
    font: 12px var(--mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ---- preview ---- */
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  iframe:not([src]) {
    display: none;
  }
  .empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    margin: 0;
    padding: 32px;
    color: var(--dim);
    font: 13px var(--mono);
    text-align: center;
    background:
      radial-gradient(circle, #ffffff10 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--term-bg);
  }
  [data-demo-empty-text] {
    max-width: 36ch;
    color: var(--muted);
    line-height: 1.6;
  }
  .wait {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid #ffffff1f;
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  .stage[data-busy] .wait {
    display: block;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .status {
    color: var(--accent);
    font: 12px var(--mono);
  }

  /* ---- status bar: setup steps, and a scan line while setting up ---- */
  .statusbar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 12px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .scan {
    position: absolute;
    top: -1px;
    left: 0;
    width: 30%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
  }
  .statusbar[data-busy] .scan {
    opacity: 1;
    animation: scan 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes scan {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(440%);
    }
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--dim);
    font: 12px var(--mono);
  }
  .steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s;
  }
  .steps li:not(:last-child)::after {
    content: '';
    width: 12px;
    height: 1px;
    margin-left: 6px;
    background: var(--line-strong);
  }
  .steps i {
    width: 6px;
    height: 6px;
    background: currentColor;
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  .steps li.done {
    color: var(--muted);
  }
  .steps li.done i {
    background: var(--accent);
  }
  .steps li.now {
    color: var(--text);
  }
  .steps li.now i {
    background: var(--accent);
    box-shadow: 0 0 0 3px #7be3b433;
    animation: pulse 1s ease-in-out infinite alternate;
  }
  .steps li.skip {
    display: none;
  }
  @keyframes pulse {
    to {
      box-shadow: 0 0 0 5px #7be3b411;
    }
  }
  .statusline {
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font: 12px var(--mono);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  @media (prefers-reduced-motion: reduce) {
    .statusbar[data-busy] .scan,
    .steps li.now i {
      animation: none;
    }
  }

  /* ---- failure and unsupported-browser panel ---- */
  .note-title {
    margin: 0;
    font: 500 18px var(--sans);
  }
  .firstrun {
    margin: 10px 0 0;
    color: var(--muted);
    font: 12px/1.6 var(--mono);
  }
  .retry {
    margin-left: 10px;
  }
  .retry:hover {
    border-color: var(--accent);
  }

  /* ---- "this is a real terminal" ---- */
  .term-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    margin: 0;
    padding: 6px 10px;
    border: 1px solid var(--line-strong);
    background: #0b0b0ee6;
    color: var(--muted);
    font: 12px var(--mono);
    pointer-events: none;
  }

  /* ---- preview toolbar ---- */
  .preview-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ports {
    padding: 1px 4px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: 12px var(--mono);
  }
  .tool {
    display: grid;
    place-items: center;
    width: 24px;
    height: 22px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 13px var(--mono);
    cursor: pointer;
  }
  .tool:hover:not([disabled]),
  .tool[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--text);
  }
  .tool[disabled] {
    opacity: 0.4;
    cursor: default;
  }
  /* Full-size preview: the preview takes the whole stage. */
  .stage[data-full-preview] {
    grid-template-areas: 'preview preview' 'preview preview';
  }
  .stage[data-full-preview] :global(.term-window),
  .stage[data-full-preview] :global(.editor-window) {
    display: none;
  }

  @media (max-width: 1080px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
    .picker {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 920px) {
    .stage[data-full-preview] {
      grid-template-rows: 640px;
      grid-template-areas: 'preview';
    }
    .stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 380px 320px 420px;
      grid-template-areas: 'term' 'editor' 'preview';
      height: auto;
    }
  }
  @media (max-width: 560px) {
    .picker {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
