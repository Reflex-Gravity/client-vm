---
// SPDX-License-Identifier: Apache-2.0
import { REPO, doc, upcoming } from '../content/landing.ts';
---

<footer>
  <div class="wrap inner">
    <p class="fine">
      <span class="brand">clientvm</span> · free and open source, Apache-2.0 · © 2026 The ClientVM
      Authors · next up: <span class="next">{upcoming.name}</span>
    </p>
    <nav aria-label="Footer">
      <a href={REPO}>GitHub</a>
      <a href={doc('architecture')}>Architecture</a>
      <a href={doc('hosting')}>Hosting</a>
      <a href={doc('agent-api')}>Agent API</a>
      <a href="/index.md">Markdown</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    padding-block: 40px;
    border-bottom: 0;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .fine {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .brand {
    font-family: var(--mono);
    color: var(--text);
  }
  .next {
    color: var(--accent);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
