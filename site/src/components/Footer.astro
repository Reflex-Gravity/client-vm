---
// SPDX-License-Identifier: Apache-2.0
import { REPO, footerColumns, upcoming } from '../content/landing.ts';
---

<footer>
  <div class="wrap">
    <div class="top">
      <div class="about">
        <p class="brand">clientvm</p>
        <p class="tag">Node.js, bash and npm in a browser tab, for AI agents.</p>
        <div class="cta">
          <p>Building something with ClientVM?</p>
          <a class="btn" href={`${REPO}/discussions`}>Tell us in Discussions</a>
        </div>
      </div>
      {
        footerColumns.map((col) => (
          <nav aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <p class="fine">
      Free and open source, Apache-2.0 · © 2026 The ClientVM Authors · next up:
      <span class="next">{upcoming.name}</span> · <a href="/index.md">this page as markdown</a>
    </p>
  </div>
</footer>

<style>
  footer {
    padding-block: 64px 40px;
    border-bottom: 0;
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .brand {
    margin: 0;
    font: 500 22px var(--display);
  }
  .tag {
    max-width: 34ch;
    margin: 8px 0 0;
    color: var(--muted);
  }
  .cta {
    margin-top: 24px;
  }
  .cta p {
    margin: 0 0 10px;
    font-size: 14px;
  }
  h2 {
    margin: 0 0 12px;
    color: var(--muted);
    font: 500 11px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
  .fine {
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 13px;
  }
  .fine a {
    color: var(--dim);
    text-decoration: underline;
  }
  .next {
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
