---
// SPDX-License-Identifier: Apache-2.0
// How it works, as four steps beside a diagram. scripts/how.ts plays them in
// turn while the section is on screen: the active step's part of the diagram
// lights up and a packet runs along its path (SVG animateMotion). Picking a
// step shows it and pauses the tour. Without JavaScript every step and the
// whole diagram show at once.
import { howItWorks, howItWorksTech } from '../content/landing.ts';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="how" class="how" data-how>
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow"><span><span class="n">02</span> / how it works</span></p>
        <h2>Four steps, <span class="soft">all inside the browser.</span></h2>
      </div>
      <button type="button" class="toggle" data-how-toggle hidden>pause</button>
    </div>

    <div class="layout">
      <ol class="steps" data-how-steps>
        {
          howItWorks.map((h, i) => (
            <li>
              <button type="button" class="step" data-how-step={i + 1} aria-pressed="false">
                <span class="num">{pad(i + 1)}</span>
                <span class="title">{h.title}</span>
                <span class="more">
                  <span class="more-inner">
                    <code>{h.code}</code>
                    <span class="body">{h.body}</span>
                  </span>
                </span>
                <span class="bar" aria-hidden="true">
                  <i />
                </span>
              </button>
            </li>
          ))
        }
      </ol>

      <figure class="diagram">
        <svg
          viewBox="0 0 760 440"
          role="img"
          aria-labelledby="how-title how-desc"
          data-how-diagram
        >
          <title id="how-title">How ClientVM runs code</title>
          <desc id="how-desc">
            Your page sends a message to a sandbox on its own origin. There a kernel worker runs
            node, bash and npm as Web Workers. A service worker serves the server they start as a
            preview, which your page shows in an iframe.
          </desc>
          <defs>
            <radialGradient id="pk-glow">
              <stop offset="0" stop-color="#d9fff0"></stop>
              <stop offset="0.35" stop-color="#7be3b4"></stop>
              <stop offset="1" stop-color="#7be3b4" stop-opacity="0"></stop>
            </radialGradient>
            <pattern id="how-dots" width="16" height="16" patternUnits="userSpaceOnUse">
              <rect x="7.5" y="7.5" width="1" height="1" fill="#ffffff22"></rect>
            </pattern>
          </defs>
          <rect width="760" height="440" fill="url(#how-dots)"></rect>

          <!-- 1 · your page -->
          <g class="z s1 s4">
            <rect class="frame" x="10" y="70" width="170" height="300"></rect>
            <text x="28" y="100" class="label">your-app.com</text>
            <text x="28" y="120" class="sub">your page</text>
            <rect class="inner" x="28" y="146" width="134" height="58"></rect>
            <text x="44" y="172" class="item">controller</text>
            <text x="44" y="190" class="sub">checks messages</text>
            <rect class="inner" x="28" y="222" width="134" height="58"></rect>
            <text x="44" y="248" class="item">your UI</text>
            <text x="44" y="266" class="sub">terminal · iframe</text>
            <text x="28" y="350" class="sub">no COOP/COEP</text>
          </g>

          <!-- edge: page → sandbox -->
          <g class="z s1">
            <path id="how-e1" class="edge" d="M180 175 H262"></path>
            <text x="221" y="163" text-anchor="middle" class="tiny">message</text>
          </g>

          <!-- 2 · the sandbox and its kernel -->
          <g class="z s2 s3">
            <rect class="frame dashed" x="262" y="20" width="290" height="360"></rect>
            <text x="280" y="50" class="label">&lt;id&gt;.sandbox</text>
            <text x="280" y="70" class="sub">own origin · hidden iframe</text>
          </g>
          <g class="z s2 s3">
            <rect class="inner kernel" x="280" y="96" width="254" height="92"></rect>
            <text x="298" y="124" class="item">kernel worker</text>
            <text x="298" y="146" class="sub">files · processes · terminals</text>
            <text x="298" y="166" class="sub">ports · mailbox · limits</text>
          </g>

          <!-- 3 · processes -->
          <g class="z s3">
            <path id="how-e3a" class="edge" d="M319 188 V262"></path>
            <path id="how-e3" class="edge" d="M407 188 V262"></path>
            <path id="how-e3b" class="edge" d="M495 188 V262"></path>
            <text x="413" y="230" class="tiny">syscalls</text>
            <rect class="inner proc" x="280" y="262" width="78" height="52"></rect>
            <text x="319" y="293" text-anchor="middle" class="item small">node</text>
            <rect class="inner proc" x="368" y="262" width="78" height="52"></rect>
            <text x="407" y="293" text-anchor="middle" class="item small">bash</text>
            <rect class="inner proc" x="456" y="262" width="78" height="52"></rect>
            <text x="495" y="293" text-anchor="middle" class="item small">npm</text>
            <text x="280" y="345" class="sub">one Web Worker each</text>
          </g>

          <!-- 4 · preview, and back to your page -->
          <g class="z s4">
            <path id="how-e4" class="edge" d="M534 142 H576 V225 H600"></path>
            <text x="675" y="108" text-anchor="middle" class="tiny">via service worker</text>
            <rect class="frame" x="600" y="120" width="150" height="210"></rect>
            <text x="614" y="148" class="label">preview</text>
            <text x="614" y="168" class="sub">&lt;id&gt;-p5173</text>
            <rect class="inner" x="614" y="186" width="122" height="128"></rect>
            <rect class="mock" x="626" y="200" width="70" height="8"></rect>
            <rect class="mock dim" x="626" y="218" width="98" height="5"></rect>
            <rect class="mock dim" x="626" y="230" width="86" height="5"></rect>
            <rect class="mock acc" x="626" y="250" width="44" height="14"></rect>
            <path id="how-e5" class="edge" d="M675 330 V412 H95 V370"></path>
            <text x="385" y="404" text-anchor="middle" class="tiny">shown in an iframe on your page</text>
          </g>

          <!-- packets, one set per step; scripts/how.ts shows the active step's -->
          <g class="pk pk1">
            <circle r="9" fill="url(#pk-glow)">
              <animateMotion dur="1.4s" repeatCount="indefinite"><mpath href="#how-e1"></mpath></animateMotion>
            </circle>
          </g>
          <g class="pk pk2">
            <rect class="ring" x="280" y="96" width="254" height="92"></rect>
          </g>
          <g class="pk pk3">
            <circle r="8" fill="url(#pk-glow)">
              <animateMotion dur="0.9s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#how-e3"></mpath></animateMotion>
            </circle>
            <circle r="6" fill="url(#pk-glow)">
              <animateMotion dur="1.3s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#how-e3a"></mpath></animateMotion>
            </circle>
            <circle r="6" fill="url(#pk-glow)">
              <animateMotion dur="1.1s" repeatCount="indefinite" keyPoints="1;0;1" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#how-e3b"></mpath></animateMotion>
            </circle>
          </g>
          <g class="pk pk4">
            <circle r="9" fill="url(#pk-glow)">
              <animateMotion dur="1.2s" repeatCount="indefinite"><mpath href="#how-e4"></mpath></animateMotion>
            </circle>
            <circle r="9" fill="url(#pk-glow)">
              <animateMotion dur="2.4s" repeatCount="indefinite"><mpath href="#how-e5"></mpath></animateMotion>
            </circle>
          </g>
        </svg>
      </figure>
    </div>

    <p class="tech">
      <span class="tech-label">under the hood</span>
      {howItWorksTech.map((t) => <a href={t.href}>{t.label}</a>)}
    </p>
  </div>
</section>

<script>
  import '../scripts/how.ts';
</script>

<style>
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 48px;
  }
  .toggle {
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 12px var(--mono);
    cursor: pointer;
  }
  .toggle:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  /* ---- the steps ---- */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
  }
  .steps li {
    display: flex;
    flex: 1;
  }
  .step {
    position: relative;
    display: grid;
    flex: 1;
    grid-template-columns: auto 1fr;
    align-content: start;
    gap: 4px 16px;
    padding: 22px 24px;
    border: 0;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .step:hover {
    color: var(--text);
  }
  .num {
    grid-row: span 2;
    color: var(--dim);
    font: 500 24px/1 var(--display);
    transition: color 0.3s;
  }
  .title {
    color: inherit;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .more {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .more-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
    overflow: hidden;
  }
  .more code {
    align-self: start;
    margin-top: 8px;
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    background: var(--term-bg);
    color: var(--accent);
    font-size: 12px;
  }
  .body {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.55;
  }
  .bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* With JavaScript: only the active step is open. */
  .steps[data-ready] .step:not([aria-pressed='true']) .more {
    grid-template-rows: 0fr;
  }
  .step[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
  }
  .step[aria-pressed='true'] .num {
    color: var(--accent);
  }
  .step[aria-pressed='true'] .bar i {
    transform: scaleX(1);
  }
  .step[aria-pressed='true'].timed .bar i {
    animation: fill var(--how-ms, 5000ms) linear both;
  }
  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  /* ---- the diagram ---- */
  .diagram {
    margin: 0;
    padding: 24px;
    background: var(--bg);
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    font-family: var(--sans);
  }
  .z {
    transition: opacity 0.5s;
  }
  .frame {
    fill: #0a0a0d;
    stroke: #ffffff26;
    transition: stroke 0.5s;
  }
  .frame.dashed {
    stroke-dasharray: 5 4;
  }
  .inner {
    fill: #141418;
    stroke: #ffffff14;
    transition:
      stroke 0.5s,
      fill 0.5s;
  }
  .mock {
    fill: #ffffff2e;
  }
  .mock.dim {
    fill: #ffffff14;
  }
  .mock.acc {
    fill: #7be3b4;
    opacity: 0.7;
  }
  .label {
    fill: #ecebe8;
    font: 600 14px var(--mono);
  }
  .item {
    fill: #ecebe8;
    font-size: 14px;
    font-weight: 500;
  }
  .item.small {
    font: 500 13px var(--mono);
  }
  .sub {
    fill: #8d8c93;
    font-size: 12px;
  }
  .tiny {
    fill: #8d8c93;
    font: 11px var(--mono);
  }
  .edge {
    fill: none;
    stroke: #ffffff3a;
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }

  /* The tour (scripts/how.ts sets data-step): other parts dim, this one lights. */
  .pk {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .ring {
    fill: none;
    stroke: #7be3b4;
    stroke-width: 2;
    animation: ring 1.4s ease-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes ring {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.08, 1.25);
    }
  }
  svg[data-step='1'] .z:not(.s1),
  svg[data-step='2'] .z:not(.s2),
  svg[data-step='3'] .z:not(.s3),
  svg[data-step='4'] .z:not(.s4) {
    opacity: 0.2;
  }
  svg[data-step='1'] .s1 .frame,
  svg[data-step='2'] .s2 .frame,
  svg[data-step='4'] .s4 .frame,
  svg[data-step='2'] .kernel,
  svg[data-step='3'] .kernel,
  svg[data-step='3'] .proc {
    stroke: #7be3b4;
  }
  svg[data-step='3'] .proc {
    fill: #7be3b414;
  }
  svg[data-step='1'] .s1 .edge,
  svg[data-step='3'] .s3 .edge,
  svg[data-step='4'] .s4 .edge {
    stroke: #7be3b4aa;
    animation: march 0.8s linear infinite;
  }
  @keyframes march {
    to {
      stroke-dashoffset: -7;
    }
  }
  svg[data-step='1'] .pk1,
  svg[data-step='2'] .pk2,
  svg[data-step='3'] .pk3,
  svg[data-step='4'] .pk4 {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .pk {
      display: none;
    }
    .edge,
    .ring {
      animation: none !important;
    }
  }

  /* ---- under the hood ---- */
  .tech {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 24px 0 0;
    font: 12px var(--mono);
  }
  .tech-label {
    margin-right: 8px;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tech a {
    padding: 3px 10px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .tech a:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
