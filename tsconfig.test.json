{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "customConditions": ["@clientvm/source"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.fixture.ts",
    "packages/*/src/**/*.d.ts",
    "test/**/*.ts",
    "*.config.ts",
    "packages/sandbox-host/vite.config.ts"
  ]
}
